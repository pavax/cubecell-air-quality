{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CubeCell: Build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/cubecell.ps1",
        "-Action",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "CubeCell: Upload",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/cubecell.ps1",
        "-Action",
        "upload"
      ],
      "problemMatcher": []
    },
    {
      "label": "CubeCell: Build & Upload",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/cubecell.ps1",
        "-Action",
        "flash"
      ],
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "CubeCell: Serial monitor",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/cubecell.ps1",
        "-Action",
        "monitor"
      ],
      "problemMatcher": []
    }
  ]
}
